# ================================================================
# AwaazSetu AI - Backend Environment Variables
# Copy this file to .env and fill in your values
# ================================================================

# Server
NODE_ENV=development
PORT=5001

# MongoDB Atlas
# Get from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/awaazsetu?retryWrites=true&w=majority

# JWT — use a strong random secret (min 32 chars)
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_characters
JWT_EXPIRE=24h

# ================================================================
# GNANI AI CREDENTIALS — Get from https://gnani.ai
# ================================================================

# Gnani Prisma STT
PRISMA_API_ENDPOINT=https://api.vachana.ai/stt/v3
PRISMA_API_KEY_ID=your_prisma_api_key_id_here

# Gnani Evon v3.3 Reasoning
# Deploy the model on HuggingFace or a GPU server and point here
# Model: https://huggingface.co/gnani/gnani-evon-v3.3-30B-A3B
EVON_INFERENCE_ENDPOINT=https://your-evon-endpoint.com/v1/inference

# Gnani Timbre TTS
TIMBRE_API_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_API_KEY_ID=your_timbre_api_key_id_here

# ================================================================
# File Upload
# ================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ================================================================
# Security
# ================================================================
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
